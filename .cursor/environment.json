{
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "bash scripts/cloud-install.sh",
  "start": "bash scripts/cloud-start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ./gradlew bootRun --no-daemon"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ]
}
