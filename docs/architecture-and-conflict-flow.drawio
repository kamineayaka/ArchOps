<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="ArchOps" version="22.1.0" type="device">
  <diagram id="runtime" name="运行时架构">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="ArchOps 运行时架构&#10;实线 = 已在 main。虚线 = 合同已写，进程或这条运输还没建。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="person" value="人&#10;不记操作者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="120" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cp" value="控制面&#10;一个进程，可多副本&#10;公开 API 仍是 REST&#10;不持模型密钥，生产不 SSH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="engine" value="执行引擎&#10;唯一会改主机的部件&#10;解密凭证，MINA SSH&#10;做步骤断言" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="250" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ai" value="AI 编排层&#10;合同里有 Deployment&#10;进程还没建&#10;执行期只观察" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="120" width="250" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="model" value="模型 API&#10;HTTPS 白名单&#10;密钥只在编排层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1420" y="140" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pg" value="PostgreSQL&#10;关系真相" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="360" width="140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="Redis&#10;锁、缓存&#10;不是真相" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="360" width="140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="host" value="被观测主机　至多一个 Host Agent，也可以不装" style="swimlane;html=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="520" width="980" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="agent" value="Host Agent&#10;心跳、快照、探测命令&#10;直连控制面写观测&#10;不经过执行引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="host">
          <mxGeometry x="40" y="50" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="cmd" value="本机命令&#10;探测：Agent 自己跑&#10;修实际：引擎 SSH 进来跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="host">
          <mxGeometry x="380" y="60" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="noagent" value="没有 Agent 的主机&#10;修实际仍只走执行引擎的 SSH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=13;" vertex="1" parent="host">
          <mxGeometry x="680" y="60" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="k8s" value="交付目标（ADR-0049，清单还没写）&#10;控制面、执行引擎、AI 编排层各自一个 Kubernetes Deployment，用 Service DNS 寻址。&#10;不用 Eureka，不在内部 gRPC 前放 Spring Cloud Gateway。Host Agent 留在主机上，不进集群。&#10;本地 Compose 只起 Postgres、Redis、控制面、执行引擎。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1100" y="360" width="560" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="forbid" value="编排层不调用执行引擎，不持有引擎的客户端证书，不 SSH 到主机。&#10;引擎不把断言直接发给 AI。模型不判步骤成败，也不能定稿策展。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1100" y="820" width="560" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="绿 = 主机与观测　　蓝 = 控制面与真相　　黄 = 执行引擎　　紫虚线 = 编排层，合同有、进程未建" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="820" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e-person-cp" value="REST /api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="person" target="cp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cp-pg" value="读写真相" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="cp" target="pg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cp-redis" value="锁，代发前加" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="cp" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cp-engine" value="gRPC 一次一步&#10;带上期望返回值" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;fontSize=12;" edge="1" parent="1" source="cp" target="engine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-engine-cp" value="只回成败&#10;详情进 executionLog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=0;strokeColor=#d6b656;fontSize=12;" edge="1" parent="1" source="engine" target="cp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="845" y="100"/>
              <mxPoint x="420" y="100"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-engine-host" value="MINA SSH&#10;修实际" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;fontSize=12;" edge="1" parent="1" source="engine" target="host">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-agent-cp" value="心跳 / 快照 / probeResults" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontSize=12;" edge="1" parent="1" source="agent" target="cp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="480"/>
              <mxPoint x="240" y="480"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-cp-agent" value="心跳响应里带回探测任务&#10;控制面不推送，也不 SSH 下发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontSize=12;" edge="1" parent="1" source="cp" target="agent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="500"/>
              <mxPoint x="140" y="500"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-agent-cmd" value="跑探测命令" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontSize=12;" edge="1" parent="host" source="agent" target="cmd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cp-ai" value="gRPC　派作业、交回建议&#10;合同已改运输，进程未建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;dashed=1;strokeColor=#9673a6;fontSize=12;" edge="1" parent="1" source="cp" target="ai">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="80"/>
              <mxPoint x="1225" y="80"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-ai-model" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontSize=12;" edge="1" parent="1" source="ai" target="model">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="discover" name="冲突发现">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="dtitle" value="冲突发现　探测任务由控制面判断。策展期望值是唯一的正常。没有原因种类。" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="task" value="控制面保存探测任务&#10;主机 + 命令 + 策展期望值&#10;同一主机上的任务互相独立" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="pull" value="Host Agent 心跳拉取任务&#10;在本机跑命令&#10;把结构化结果交回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="judge" value="控制面判断&#10;Agent 不判断&#10;不把每次结果交给 AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="100" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ok" value="相等&#10;正常&#10;不开冲突" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="40" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="conflict" value="可读，且不等于策展值&#10;冲突&#10;带上原始证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="160" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="hollow" value="读不出，或到点没交回&#10;这一条任务空洞&#10;空洞不是冲突" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="290" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rule" value="总规则（不限探测）&#10;两侧都有当前可用值，并且不等 → 冲突。冲突是偏差，不是对错。&#10;缺一侧、读不出、超时 → 空洞。空洞不作废成一种冲突，也不进原因分类。&#10;升级的合并键是对象 + 关系类型。升级或空洞会作废这条上的活跃计划。&#10;身份失联是旗标，叠在问法上，不是一种诊断。未绑定留在冲突案件之外。&#10;一台主机至多一个探测 Agent。没装 Agent 的主机仍然合法。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="980" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="ui" value="页面 /probe-tasks&#10;建任务，看正常 / 冲突 / 空洞&#10;冲突上点修实际或改理想" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="480" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e-task-pull" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="1" source="task" target="pull">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-pull-judge" value="结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontSize=12;" edge="1" parent="1" source="pull" target="judge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-judge-ok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="judge" target="ok">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-judge-c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="judge" target="conflict">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-judge-h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="judge" target="hollow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-c-ui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="1" source="conflict" target="ui">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="resolve" name="冲突解决">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rtitle" value="冲突解决　三个动作，没有原因分类。人审不记操作者。AI 不能定稿策展，也不判步骤成败。" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1500" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="lane-ideal" value="改理想　已在 main" style="swimlane;html=1;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="520" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="i1" value="冲突上请求改理想&#10;开出草案，此时不写策展" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane-ideal">
          <mxGeometry x="40" y="50" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="i2" value="接受这一条&#10;把观测到的值写成策展期望值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane-ideal">
          <mxGeometry x="40" y="160" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="i3" value="控制面立刻再判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane-ideal">
          <mxGeometry x="40" y="270" width="420" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="i4" value="相等 → 待确认关闭 → 确认关闭&#10;冲突结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="lane-ideal">
          <mxGeometry x="40" y="360" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="i5" value="确认关闭之前又来一条不等的结果&#10;同一条冲突重新打开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="lane-ideal">
          <mxGeometry x="40" y="460" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="i6" value="拒绝这一条&#10;策展不变，冲突仍打开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane-ideal">
          <mxGeometry x="40" y="570" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lane-actual" value="修实际　计划、单步代发、断言已在 main。命令仍是占位。" style="swimlane;html=1;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="70" width="560" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="冲突上请求修实际&#10;开出待审计划，不写观测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="lane-actual">
          <mxGeometry x="30" y="50" width="490" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="人批准并冻结&#10;控制面加 Redis 锁，按游标一次发一步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="lane-actual">
          <mxGeometry x="30" y="140" width="490" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="执行引擎 SSH 到主机，跑这一步&#10;占位三步：预检、迁移容器、刷新观测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="lane-actual">
          <mxGeometry x="30" y="230" width="490" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="步骤断言&#10;命令成功退出，且 JSON 输出包含该步冻结的期望值&#10;不看策展和观测是否已经一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="lane-actual">
          <mxGeometry x="30" y="330" width="490" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="成功 → 控制面发下一步，直到计划走完&#10;走完仍不写观测。实际变了没有，靠之后的探测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="lane-actual">
          <mxGeometry x="30" y="440" width="490" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="失败 → 计划作废，不能改一步再试&#10;空洞、升级、失联会停发下一步；迟到的成功丢掉&#10;真命令替换占位、做完写观测：还没做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="lane-actual">
          <mxGeometry x="30" y="540" width="490" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="lane-hollow" value="恢复观测通道　只显示，不落库" style="swimlane;html=1;startSize=32;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="70" width="480" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="这一条任务是空洞&#10;页面只给出「恢复观测通道」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane-hollow">
          <mxGeometry x="30" y="50" width="410" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="没有冲突编号，选支接口会拒绝这个动作&#10;所以现在点了也不落库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=13;" vertex="1" parent="lane-hollow">
          <mxGeometry x="30" y="160" width="410" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="通道恢复后，下一次探测交回可读结果&#10;控制面再按策展值判断正常或冲突" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane-hollow">
