# 复制后编辑，再启动：
#   cp .env.example .env
#
# 镜像交付（推荐，无需源码）：
#   docker compose up -d
#
# 本机从源码构建：
#   docker compose -f compose.yaml -f compose.build.yaml up -d --build
#
# 全栈（Postgres + Redis + Neo4j + backend + frontend）建议主机内存 ≥4–8 GiB。

# --- 镜像（镜像即交付物）---
# 仓库前缀，最终镜像名为：
#   ${ARCHOPS_IMAGE_PREFIX}/backend:${ARCHOPS_VERSION}
#   ${ARCHOPS_IMAGE_PREFIX}/frontend:${ARCHOPS_VERSION}
ARCHOPS_IMAGE_PREFIX=ghcr.io/kamineayaka/archops
ARCHOPS_VERSION=latest

# --- 平台密钥（可留空，首次启动自动生成） ---
JWT_SECRET=
CREDENTIALS_MASTER_KEY=

# --- 数据库 ---
POSTGRES_DB=archops
POSTGRES_USER=archops
POSTGRES_PASSWORD=archops

# --- HTTP ---
HTTP_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost,http://your-server-ip

# --- 可选：构建镜像源（仅 compose.build.yaml / build-images.sh 使用） ---
# NPM_REGISTRY=https://registry.npmmirror.com
# MAVEN_MIRROR=https://maven.aliyun.com/repository/public

# --- 可选：JVM ---
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# --- AI（可选种子；部署后也可在管理后台配置 Provider） ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_DEFAULT_PROVIDER=openai-compat
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
RAG_ENABLED=true
RAG_PROVIDER=openai-compat
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35

# --- Architecture SSOT ---
ARCH_AUTO_MERGE_ENABLED=false

# --- Neo4j（必选）---
# Neo4j 5.x 要求密码 ≥ 8 字符。
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=archopsneo4j
NEO4J_DATABASE=neo4j
