# Copy to .env next to compose.yaml if needed (Compose auto-loads).
POSTGRES_DB=archops
POSTGRES_USER=archops
POSTGRES_PASSWORD=archops
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=
ARCHOPS_PORT=8080
ARCHOPS_IMAGE=archops:latest
# Docker Hub via DaoCloud (override to official names if the mirror is unreachable):
# POSTGRES_IMAGE=postgres:16
# REDIS_IMAGE=redis:7-alpine
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
# Required for archops + executor (same value on both). Generate: openssl rand -base64 32
# Leave blank and those services refuse to boot (no source-code default). Do not commit a real key.
ARCHOPS_CREDENTIALS_ENCRYPTION_KEY_BASE64=
