# 复制为 .env 后再部署：
#   cp .env.example .env

# --- 平台密钥（可留空，首次启动自动生成） ---
JWT_SECRET=
CREDENTIALS_MASTER_KEY=

# --- 数据库 ---
POSTGRES_DB=archops
POSTGRES_USER=archops
POSTGRES_PASSWORD=archops

# --- HTTP ---
HTTP_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost,http://your-server-ip

# --- 构建镜像源（国内/慢网强烈建议开启，否则 npm/Maven 可能耗时数十分钟） ---
# 国内 ECS 推荐直接取消注释；脚本也可用 USE_CN_MIRRORS=1 / auto
NPM_REGISTRY=https://registry.npmmirror.com
MAVEN_MIRROR=https://maven.aliyun.com/repository/public
# 写法 B：远程脚本一键
#   USE_CN_MIRRORS=1 ./deploy/scripts/remote-deploy.sh root@HOST
# 或本机构建：
#   USE_CN_MIRRORS=1 ./deploy/scripts/compose-build.sh

# --- JVM（Dockerfile.backend 使用；小内存 VPS / compose.lowmem.yaml 可调） ---
# JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m

# --- AI（可选种子迁移；部署后也可在管理后台配置 Provider） ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 以下历史环境变量在 UI 已配置 Provider 后会被忽略。
AI_DEFAULT_PROVIDER=openai-compat
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
RAG_ENABLED=true
RAG_PROVIDER=openai-compat
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35

# --- Architecture SSOT ---
ARCH_AUTO_MERGE_ENABLED=false

# --- Graph / Neo4j ---
# 默认关闭。≈2 GiB 机严禁开启（lowmem 脚本会强制关掉 true）。
ARCHOPS_GRAPH_ENABLED=false
# 启用图能力时（内存充足）必须两处一起开，缺一不可：
#   ARCHOPS_GRAPH_ENABLED=true
#   COMPOSE_PROFILES=graph
# 然后：docker compose -f compose.yaml -f compose.graph.yaml --profile graph ... up -d
# （remote-deploy.sh 在检测到 graph 时会自动叠加 compose.graph.yaml）
# NEO4J_URI / USER / PASS 由 compose.graph.yaml 注入，无需在 graph=false 时填写。
# Neo4j 5.x 要求密码 ≥ 8 字符（短密码会导致 neo4j 容器 exit 70 重启循环）。
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=archopsneo4j
# COMPOSE_PROFILES=graph
