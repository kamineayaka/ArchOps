# Rsync filter for ArchOps → deploy host (/opt/archops).
# Used by deploy/scripts/remote-deploy.sh (merge). First match wins.
#
# Only sync trees needed to build/run Compose for another operator.
# docs / IDE / VCS / secrets stay on the workstation.

# --- drop junk everywhere ---
- .git/
- .cursor/
- .idea/
- .vscode/
- node_modules/
- .vite/
- *.log
- .env
- .env.*
- !.env.example
- *.pem
- *.key
- *.p12
- secrets/
- credentials.json
- /VERSION

# --- only these top-level trees ---
+ /deploy/
+ /deploy/**
+ /backend/
+ /backend/**
+ /frontend/
+ /frontend/**

# --- everything else at repo root (docs, README, LICENSE, …) ---
- /**
