# syntax=docker/dockerfile:1
# Runtime-only image when the JAR was built outside Docker (e.g. CI / agent host).
# Expects backend/target/*.jar already present in the build context.
# No apt/curl: Compose healthcheck uses /dev/tcp (see deploy/compose/compose.yaml).

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY target/*.jar app.jar
EXPOSE 8080
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
